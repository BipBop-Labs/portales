{
  "name": "portales",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "portales": "dist/apps/cli/src/main.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/write-build-info.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "update": "git pull --ff-only && npm ci && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.1",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "playwright": "^1.55.0",
    "zod": "^4.4.3"
  },
  "version": "0.1.0"
}
